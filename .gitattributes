# Normalize line endings in the repository; check out LF in the working tree.
* text=auto eol=lf

# Binary assets that must never be touched.
*.png binary
*.jpg binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles and generated bundles are not worth merging line-by-line.
pnpm-lock.yaml -diff
package-lock.json -diff
